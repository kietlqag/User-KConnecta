# User Backend — copy to .env and fill in real values
# NEVER commit .env to source control

# --- Local dev (default profile: local) ---
SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DB?sslmode=require
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# REQUIRED — app will not start on Render without these.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-byte-hex-secret

JWT_EXPIRATION=86400000

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=replace-with-32-byte-hex-key

ADMIN_SERVICE_URL=http://localhost:8082

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://user-k-connecta.vercel.app

REDIS_HOST=localhost
REDIS_PORT=6379

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- LiveKit HLS Egress → Cloudflare R2 (tua live từ đầu buổi) ---
# Bật trên Render sau khi tạo R2 bucket + public URL. Local: để false (fallback WebRTC DVR).
# LIVEKIT_EGRESS_ENABLED=true
# LIVEKIT_EGRESS_S3_BUCKET=kconnecta-live-hls
# LIVEKIT_EGRESS_S3_ACCESS_KEY=<R2 Access Key ID>
# LIVEKIT_EGRESS_S3_SECRET=<R2 Secret Access Key>
# LIVEKIT_EGRESS_S3_REGION=auto
# LIVEKIT_EGRESS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# LIVEKIT_EGRESS_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
#   hoặc custom domain: https://live-hls.yourdomain.com
# R2 CORS (bucket Settings): Allow GET/HEAD từ https://kconnecta.vercel.app

# Google Gemini AI (content moderation) — comma-separated; falls back key-by-key on quota errors
GEMINI_API_KEYS=
# Optional: model chain high → low free-tier quota (default is fine for most setups)
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3-flash,gemini-3.5-flash

APP_TIMEZONE=Asia/Ho_Chi_Minh
PORT=8080

# --- Render Web Service (Dashboard → Environment) ---
# SPRING_PROFILES_ACTIVE=render
# DB_URL / DB_USERNAME / DB_PASSWORD  → link Render PostgreSQL (use Internal URL)
# JWT_SECRET                          → same value as local (or new prod secret)
# INTERNAL_API_KEY                    → same value as local
# MAIL_USERNAME / MAIL_PASSWORD
# GOOGLE_CLIENT_ID
# CLOUDINARY_*
# CORS_ALLOWED_ORIGINS=https://kconnecta.vercel.app
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_EGRESS_ENABLED=true
# LIVEKIT_EGRESS_S3_BUCKET=
# LIVEKIT_EGRESS_S3_ACCESS_KEY=
# LIVEKIT_EGRESS_S3_SECRET=
# LIVEKIT_EGRESS_S3_REGION=auto
# LIVEKIT_EGRESS_S3_ENDPOINT=
# LIVEKIT_EGRESS_PUBLIC_BASE_URL=
# REDIS_URL                           → optional but recommended (Render Redis)
# PORT                                → Render sets automatically — do not override
