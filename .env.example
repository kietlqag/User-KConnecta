# User Backend — copy to .env and fill in real values
# NEVER commit .env to source control

DB_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DB
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# REQUIRED — app will not start without these (local profile has dev fallbacks only).
# Generate with: openssl rand -hex 64
# Must be ≥ 64 chars for HS256 safety. Different from ADMIN_JWT_SECRET.
JWT_SECRET=replace-with-openssl-rand-hex-64

JWT_EXPIRATION=86400000

# Shared between User and Admin backends for internal service calls
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=replace-with-openssl-rand-hex-32

ADMIN_SERVICE_URL=http://localhost:8082

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://user-k-connecta.vercel.app

# Redis (required — used for token blacklist and OTP sessions)
# Local: redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# LiveKit local dev (must match livekit.dev.yaml keys)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Google Gemini AI (for post content moderation — leave blank to skip)
GEMINI_API_KEY=

APP_TIMEZONE=Asia/Ho_Chi_Minh
PORT=8080
